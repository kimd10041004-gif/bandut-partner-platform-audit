{
  "name": "banded-partner-platform",
  "private": true,
  "version": "29.32.0",
  "description": "반듯집수리 파트너 플랫폼 — 29-1: v17 도메인 이식 · Postgres 포트 · 스키마/트리거 변환",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:spa": "vite",
