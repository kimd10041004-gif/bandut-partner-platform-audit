    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "pg": "^8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.87.0",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
