    "audit": "npm audit --audit-level=high",
    "api:dev": "node scripts/api-server.mjs",
    "test:contract": "vitest run src/domain/ports.contract.test.ts",
    "test:pg": "vitest run tests/pg.port.test.ts",
    "test:pg:suite": "vitest run -c vitest.pg.config.ts",
    "test:mp": "vitest run tests/marketplace.http.test.ts",
    "test:reset": "vitest run tests/passwordReset.http.test.ts",
    "test:journey": "vitest run tests/signupJourney.http.test.ts",
    "test:probe": "vitest run tests/dbProbe.http.test.ts",
    "db:pg-schema": "node scripts/pg-schema.mjs",
