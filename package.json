    "e2e:next": "node scripts/e2e-next.mjs",
    "e2e:interior": "node scripts/e2e-interior.mjs",
    "e2e:layout": "node scripts/e2e-layout.mjs",
    "e2e:signup": "node scripts/e2e-signup.mjs",
    "e2e:roles": "node scripts/e2e-roles.mjs",
    "e2e:live-ui": "node scripts/e2e-live-ui.mjs",
    "e2e:trade": "node scripts/e2e-trade.mjs",
    "e2e:live": "node scripts/e2e-live.mjs"
