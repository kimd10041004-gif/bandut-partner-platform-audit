    "build:next": "next build",
    "start:next": "next start",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.api.json",
    "test": "vitest run",
    "visual-check": "node scripts/visual-check.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,json}\"",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run build:next",
